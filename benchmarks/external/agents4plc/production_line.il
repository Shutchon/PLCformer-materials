// X0 mode, X1/X2 manual forward/reverse, X3..X5 sensors A..C, X6..X8 buttons A..C.
// Y0 forward, Y1 reverse, Y2 completion. M0..M7 one-hot State; M8..M14 transition guards.
// Initialize M0=1 for source State=0; the all-zero memory is NOT a valid encoding.
LD M0
RST Y0
RST Y1
RST Y2
SET M1
RST M0
LD X0
AND M1
AND X3
OUT M8
LD X0
AND M2
AND X6
OUT M9
LD X0
AND M3
AND X4
OUT M10
LD X0
AND M4
AND X7
OUT M11
LD X0
AND M5
AND X5
OUT M12
LD X0
AND M6
AND X8
OUT M13
LD X0
AND M7
ANI X5
OUT M14
LDI X0
RST Y0
RST Y1
LDI X0
AND X1
ANI X2
SET Y0
LDI X0
AND X2
ANI X1
SET Y1
LD M9
OR M11
SET Y0
RST Y1
LD M10
OR M12
RST Y0
LD M13
SET Y2
LD M14
RST Y2
LD M1
ANI M8
OR M14
OUT M1
LD M2
ANI M9
OR M8
OUT M2
LD M3
ANI M10
OR M9
OUT M3
LD M4
ANI M11
OR M10
OUT M4
LD M5
ANI M12
OR M11
OUT M5
LD M6
ANI M13
OR M12
OUT M6
LD M7
ANI M14
OR M13
OUT M7
END
